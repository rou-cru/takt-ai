  "cards": [
    {
      "dot": "emerald",
      "title": "Controlled variable",
      "items": [
        "Crew capability, not the code: the workspace is terrain that changes from any source",
        "Entropy compounds by itself, so the loop must act before the crew pays for it",
        "Quality criterion: reject one or several impacts without overshoot or oscillation"
      ]
    },
    {
      "dot": "cyan",
      "title": "Sensors",
      "items": [
        "Base sensor is always available; every other source is fused when present",
        "Losing a sensor raises uncertainty U; it never stops estimation",
        "VFS operations are the crew's known input; the rest is disturbance"
      ]
    },
    {
      "dot": "violet",
      "title": "Control and modes",
      "items": [
        "Launch on projected entropy along the route, or on a capability alarm above E_lo",
        "Manual, assisted, autonomous: only launch authority changes",
        "A cycle runs only while no crew session is active; its effect and reversions return as health"
      ]
    }
