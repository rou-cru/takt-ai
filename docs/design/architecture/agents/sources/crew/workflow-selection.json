  "cards": [
    {
      "dot": "cyan",
      "title": "Rules",
      "items": [
        "Selection runs before each planning or implementation phase",
        "The route test is bounded units versus an integrated implementation, not one lane versus several",
        "QA is planned only when acceptance needs the QA workflow; its tail follows either development branch or a focused assessment",
        "Only the chosen route's skill is loaded; a route is never re-adopted under identical evidence"
      ]
    },
    {
      "dot": "amber",
      "title": "Not drawn",
      "items": [
        "After invariant-planning, selection returns to the first question",
        "Without QA planned, a no-development assessment delegates to the relevant quality specialist with its scope and criteria",
        "Exceptions are owned by takt-workflow-selection-exceptions"
      ]
    }
  ]
