  "cards": [
    {
      "dot": "cyan",
      "title": "Resuming",
      "items": [
        "Start from the state at close, or from an interrupted session's entries",
        "Check the claims the state names against the current workspace and any repository the memory names; verified repository state prevails"
      ]
    },
    {
      "dot": "amber",
      "title": "One message",
      "items": [
        "Present the objective, what memory claims that the repositories do not show (or the reverse), and open disputes as open",
        "Ask only what that leaves in conflict or unknown; with nothing open, continue without waiting",
        "Show what was found; resume once the user confirms which work it is and where it stands"
      ]
    },
    {
      "dot": "rose",
      "title": "Care",
      "items": [
        "Another workspace is searched when nothing in this one matches or the user points there",
        "No recorded session matches: say so and ask for a hint or start fresh"
      ]
    }
  ]
