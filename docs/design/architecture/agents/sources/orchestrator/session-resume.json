  "cards": [
    {
      "dot": "cyan",
      "title": "Two decisions",
      "items": [
        "Resuming never waits on the declaration, and failing to declare never stops the resume",
        "The declaration becomes a permanent link with the first new memory entry"
      ]
    },
    {
      "dot": "amber",
      "title": "Care",
      "items": [
        "Declare nothing doubtful; show what was found and resume once the user confirms which work it is",
        "Another workspace is searched when nothing in this one matches or the user points there",
        "A rejected declaration is not retried; before the first new entry a different continuity replaces or withdraws it"
      ]
    }
  ]
