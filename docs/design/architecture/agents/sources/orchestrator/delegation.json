  "cards": [
    {
      "dot": "cyan",
      "title": "Order",
      "items": [
        "dispatch_commit when a plan applies, then dispatch_inputs, then claim_assign for an implementation lane, then the delegation",
        "A round is concurrent only if all its delegations are issued in the same response"
      ]
    },
    {
      "dot": "amber",
      "title": "Identity",
      "items": [
        "The delegation name is the unit identity; the same name again retries it, new work gets a new name",
        "Without an author_key, claim_assign replaces overlapping claims from other root sessions, discarding their staged work; only same-root collisions are refused; with the author_key it continues the existing work"
      ]
    }
  ]
