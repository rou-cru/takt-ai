  "cards": [
    {
      "dot": "cyan",
      "title": "Loop",
      "items": [
        "The selection tree runs before every planning or implementation phase",
        "Planning runs when required invariants are missing, partial or need refinement.",
        "Invariant planning returns to the tree once its invariants are delivered"
      ]
    },
    {
      "dot": "amber",
      "title": "Acceptance and milestone",
      "items": [
        "One global Verify accepts each vertical slice after its writers finish; failed or unverified criteria block",
        "Non-blocking advisory findings stay recorded and do not delay the checkpoint",
        "A milestone commit is a separate decision, taken once acceptance is recorded and advisory review closes without a reproduction-backed defect"
      ]
    },
    {
      "dot": "violet",
      "title": "Waiting",
      "items": [
        "The user decides value, authorizations, irreversible effects and lending; technical uncertainty goes first to a competent specialist or bounded diagnosis",
        "Resuming earlier work and compaction are covered in their own views"
      ]
    },
    {
      "dot": "rose",
      "title": "Not drawn",
      "items": [
        "Direct work, recovery and delivery handling are separate views"
      ]
    }
  ]
