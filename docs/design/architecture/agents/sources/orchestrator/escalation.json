  "cards": [
    {
      "dot": "cyan",
      "title": "Triggers",
      "items": [
        "A delivery outside its scope or an unexplained workspace change",
        "Budget expiry, or an objective-blocking discovery",
        "A contract that contradicts the code with no reachable owner, or two deltas that did not converge",
        "Consolidation reporting recovery required or a changed physical base"
      ]
    },
    {
      "dot": "amber",
      "title": "Escalation",
      "items": [
        "Technical uncertainty goes to its competent specialist, or to direct investigation when the user's instruction covers it, keeping existing authority, ownership and budgets",
        "The user decides value, required authorization, irreversible effects, or no justifiable continuation; direction is awaited only on that decision",
        "At a reached bound the harness stops further consumption; a deterministic policy picks an autonomous reroute within authorized work or a closing report with the unmet criteria; only a finite, scoped user exception permits recovery beyond it",
        "An exhausted recovery is a condition for requesting the blind review pair (takt-verification-consolidation)"
      ]
    },
    {
      "dot": "rose",
      "title": "Claims",
      "items": [
        "A claim with no staged work releases without asking the user; while its unit is in flight the release is refused and names dispatch_abandon",
        "Ownership frees only once effective termination is recorded",
        "A claim holding staged work leaves by consolidation, reassignment or discard"
      ]
    }
  ]
