  "cards": [
    {
      "dot": "cyan",
      "title": "Lending",
      "items": [
        "dispatch_switch names the specialist and objective; the harness asks the user to accept them before the switch takes effect, and a refusal means reevaluate without lending",
        "requirements carry finalized document paths and useful Engram IDs, never their content; explicitly empty when none exists",
        "Only the user cuts a lent session short, with /takt-abort"
      ]
    },
    {
      "dot": "rose",
      "title": "Anomalous returns",
      "items": [
        "Result attributes cause and never grades the specialist",
        "Reconcile transition and artifact evidence; route bounded diagnosis or correction when objective, authority and continuity are established, else consult the user",
        "A malformed or incomplete envelope leaves the session unsettled"
      ]
    }
  ]
