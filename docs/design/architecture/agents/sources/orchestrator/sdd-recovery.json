  "cards": [
    {
      "dot": "cyan",
      "title": "Owners",
      "items": [
        "Structural or interface: architect. Behavior or acceptance: spec. Experience or identity: product-designer. Scope analysis: pm",
        "A discrepancy requires diagnosis, not an assumption that the contract is wrong; technical uncertainty is resolved within authority",
        "Conflicting staged deltas: both stay frozen and staged for diagnosis; the owner of the contract they share receives the unit identity and evidence"
      ]
    },
    {
      "dot": "amber",
      "title": "Declared recovery",
      "items": [
        "A binary result, acceptance entity, scope, action budget and attempt budget; budget expiry follows the bound rule (see the escalation view)",
        "After consolidation, repair forward"
      ]
    },
    {
      "dot": "rose",
      "title": "Limits and decisions",
      "items": [
        "The user decides value, required authorization, irreversible effects, or no justifiable continuation",
        "At a reached bound the harness stops further consumption; a deterministic policy picks an autonomous reroute within authorized work or a closing report with the unmet criteria; the user joins only by explicit policy",
        "Recovery beyond a reached bound takes a finite, scoped user exception; a plan revision or contract delta does not reset consumption",
        "Two consecutive failed recoveries of one acceptance entity close autonomous recovery for it; a second failing verdict for the same author key counts as one",
        "After two nonconverging contract deltas, reassess the decomposition instead of issuing a third"
      ]
    }
