  "cards": [
    {
      "dot": "cyan",
      "title": "Verification is planned",
      "items": [
        "takt-verification-consolidation plans a gate only for a completed module, a change whose deviation would cascade into later work (such as a frozen contract or interface it feeds), or an unknown state",
        "One gate covers several authors; any other delivery goes straight to consolidation"
      ]
    },
    {
      "dot": "amber",
      "title": "Milestone",
      "items": [
        "Consolidating is not a Git commit; one global Verify node accepts each vertical slice after its writers finish",
        "A milestone is committed once its computational acceptance is recorded and advisory review closes without a reproduction-backed defect, after loading takt-git-commit",
        "Findings beyond a verdict are weighed against the slice's delivery (takt-verification-consolidation): those that prevent or degrade the working slice are corrected first; those that leave it working stay recorded and do not delay the checkpoint; failed or unverified criteria block"
      ]
    },
    {
      "dot": "rose",
      "title": "Judges",
      "items": [
        "The blind pair is requested only on the conditions in takt-verification-consolidation; a contest is recorded with dispatch_contest, bounded per session, and the orchestrator delegates the Verify of the contested unit"
      ]
    },
    {
      "dot": "violet",
      "title": "Bound",
      "items": [
        "At a reached bound the harness stops further consumption; a deterministic policy picks an autonomous reroute within remaining authorized work or a closing report with the unmet criteria",
        "The user joins only by explicit policy; a new route keeps the exhausted scope's consumption"
      ]
    }
  ]
