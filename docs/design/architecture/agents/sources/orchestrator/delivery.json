  "cards": [
    {
      "dot": "cyan",
      "title": "Verification is planned",
      "items": [
        "A gate is planned only for a completed module, a change whose deviation would cascade into later work (such as a frozen contract or interface it feeds), or an unknown state",
        "One gate covers several authors; any other delivery goes straight to consolidation"
      ]
    },
    {
      "dot": "amber",
      "title": "Milestone",
      "items": [
        "Consolidating is not a Git commit; one global Verify node accepts each vertical slice after its writers finish",
        "A milestone is committed once its computational acceptance is recorded and advisory review closes without a reproduction-backed defect, after loading takt-git-commit",
        "Non-blocking advisory findings remain recorded; they neither delay the checkpoint nor require correction or reverification, while failed or unverified criteria block"
      ]
    },
    {
      "dot": "rose",
      "title": "Judges",
      "items": [
        "The blind pair is requested only on the conditions in the operations prose; takt delegates the verify of a contested unit"
      ]
    }
