  "cards": [
    {
      "dot": "cyan",
      "title": "Loop",
      "items": [
        "A failing verdict leaves the staged work untouched",
        "takt-fix starts from the verdict and runs nothing on staged work",
        "takt takes each returned delivery where the plan sends it before delegating more"
      ]
    },
    {
      "dot": "rose",
      "title": "Harness",
      "items": [
        "A claim with the author key continues the staged delta instead of discarding it",
        "The old verdict is cleared by the new write, so Verify runs again"
      ]
    }
