  "cards": [
    {
      "dot": "cyan",
      "title": "Lend",
      "items": [
        "dispatch_switch names the specialist and objective; the harness asks the user to accept before the switch takes effect, and a refusal means no lend",
        "Drafts are hypotheses; the accepted version supersedes them with the approval as evidence"
      ]
    },
    {
      "dot": "rose",
      "title": "Return",
      "items": [
        "dispatch_handoff asks the user to accept the handed-back artifact before the interface returns",
        "The switch and handoff are recorded transitions; one holder at a time, and no chaining",
        "takt-pm hands the interface back; only takt closes the memory session"
      ]
    }
  ]
