  "cards": [
    {
      "dot": "cyan",
      "title": "Sessions",
      "items": [
        "The first entry establishes the session; a declared continuation becomes permanent with that entry",
        "A close covers only entries since the preceding close; a new entry reopens the session without changing earlier closes",
        "Nothing new to close is refused without effect; exiting OpenCode does not close memory"
      ]
    },
    {
      "dot": "cyan",
      "title": "Attribution",
      "items": [
        "Crew attribution comes from a service-owned binding, not agent-supplied entry fields",
        "External clients use the same six tools through /external; the adapter supplies their session identity and optional workspace",
        "Only a root session continues or closes; an external client cannot act on crew sessions"
      ]
    },
    {
      "dot": "cyan",
      "title": "Ownership and availability",
      "items": [
        "Only the service opens memory.db; its Unix socket is private to the local user",
        "Explicit startup reuses the owner; missing, corrupt and newer stores remain distinct states",
        "Backups come from the service; semantic vectors are derived and coverage gaps remain visible"
      ]
    }
  ]
