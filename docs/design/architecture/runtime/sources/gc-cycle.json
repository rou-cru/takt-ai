  "cards": [
    {
      "dot": "cyan",
      "title": "Trigger",
      "items": [
        "A cycle is due at units/8 + mutations/40 >= 1, or on user request",
        "Skipped when a cycle is in flight or no mutations occurred"
      ]
    },
    {
      "dot": "amber",
      "title": "Hold",
      "items": [
        "The barrier holds while units are in flight or ordinary deltas are pending",
        "Each hold counts as a deferral; three deferrals abort the decision"
      ]
    },
    {
      "dot": "rose",
      "title": "Not drawn",
      "items": [
        "investigate to closed when the collector reports no change",
        "A plugin restart reconciles stored delegations, preserves another live owner's lanes, and aborts specified incomplete closure phases after lane termination; interrupted evidence is distinct from acceptance",
        "Acceptance aborts the cycle when the checked preparation changed"
      ]
    },
    {
      "dot": "violet",
      "title": "Manual path",
      "items": [
        "takt-ai gc plan, findings, refute, acceptance run outside the coordinator",
        "plan widens the scope with CodeGraph dependents; without CodeGraph it stays journal-only and records the gap. Coordinator cycles are journal-only",
        "Manual acceptance is refused while a coordinator cycle exists"
      ]
    },
    {
      "dot": "amber",
      "title": "Closure measurement",
      "items": [
        "A closing cycle publishes the mandate reversion rate from the journal: distinct consolidated (cycle,path) pairs form the denominator and attributed create/patch/delete re-edits the numerator",
        "Reads, repeated edits and unrelated work do not inflate the rate; zero registered work publishes no rate",
        "Publishing the rate never blocks closure; a rate over policy demotes the mandate"
      ]
    }
  ]
