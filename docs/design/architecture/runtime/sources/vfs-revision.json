  "cards": [
    {
      "dot": "cyan",
      "title": "Gates",
      "items": [
        "Verifier gates are prepared bound at delegation from author_keys; the verifier needs the verify grant and cannot verify its own work",
        "A verdict binds to one revision and delta hash; any new write clears it",
        "Staging by write, delete or shell: shell-prepare projects the scope, shell-import stages the captured result"
      ]
    },
    {
      "dot": "amber",
      "title": "Consolidation",
      "items": [
        "Orchestrator-only; a verdict is required only for maintenance cycles",
        "Flush writes a manifest, replaces files one by one, then verifies bases",
        "A maintenance cycle's flush is retained until the cycle completes; until then the cycle can be discarded"
      ]
    },
    {
      "dot": "rose",
      "title": "Recovery",
      "items": [
        "While recovery is pending every call is refused",
        "Restore refuses when a base changed"
      ]
    },
    {
      "dot": "violet",
      "title": "Claims",
      "items": [
        "A fresh claim_assign discards overlapping claims of other roots; a same-root overlap is a collision",
        "Reassign keeps the staged delta and clears the verdict; revoke frees paths and is refused while work is staged",
        "vfs_discard is orchestrator-only"
      ]
    }
  ]
