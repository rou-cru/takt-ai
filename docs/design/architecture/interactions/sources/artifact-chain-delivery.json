  "cards": [
    {
      "dot": "rose",
      "title": "Verdicts bind to a revision",
      "items": [
        "A verdict is tied to the revision and delta hash it read",
        "The author never verifies its own work",
        "A failing delta stays staged until corrected or discarded"
      ]
    },
    {
      "dot": "cyan",
      "title": "Matrix columns",
      "items": [
        "qa writes requirement, condition and must-not-fail",
        "tpm adds the owning node; verify adds evidence",
        "Each column is a supplements entry, never a rewrite"
      ]
    },
    {
      "dot": "emerald",
      "title": "Routing a finding",
      "items": [
        "One localized finding goes to fix, quoted verbatim",
        "Correlated problems go to dev",
        "Mutation survivors go to test, never to dev or fix"
      ]
    }
  ]
