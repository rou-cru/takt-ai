  "cards": [
    {
      "dot": "cyan",
      "title": "What travels",
      "items": [
        "takt declares IDs with dispatch_inputs; bodies never enter the brief",
        "The consumer reads bodies itself and records one entry per artifact",
        "Results come back as IDs through deliver_result"
      ]
    },
    {
      "dot": "emerald",
      "title": "Relations",
      "items": [
        "supersedes replaces a whole artifact; supplements adds a matrix column",
        "disputes stays open until someone with authority settles it"
      ]
    },
    {
      "dot": "rose",
      "title": "Coherence",
      "items": [
        "Precedence: user order, stories, business docs, derived artifacts",
        "Only the lane holding the lower-ranked document is re-dispatched",
        "Two failed alignments escalate to the user"
      ]
    }
  ]
