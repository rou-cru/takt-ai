  "cards": [
    {
      "dot": "cyan",
      "title": "Edge = trigger, node = artifact",
      "items": [
        "Each edge names the need that makes takt delegate",
        "Each node names what the specialist hands back",
        "Planning results are Engram IDs; execution results are staged work"
      ]
    },
    {
      "dot": "emerald",
      "title": "Omit when settled",
      "items": [
        "A lane is skipped when an artifact of equal rigor exists",
        "Verify is never omitted from a planned verification",
        "takt works directly only on one file, one concern, no contract change"
      ]
    },
    {
      "dot": "rose",
      "title": "Judge pair",
      "items": [
        "Only on user request, unknown-origin damage, exhausted recovery, or two phases at the ceiling",
        "Findings both report are critical; findings from one show confusion"
      ]
    }
  ]
