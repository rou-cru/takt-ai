  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime split",
      "items": [
        "The installer runs as the CLI; the harness runs inside OpenCode through plugins",
        "Plugins call back into takt-ai subcommands; the VFS plugin also holds permission hooks, lane tool sets and orchestrator-only guards",
        "The catalog is embedded in the binary; the sandbox adapter is loaded by the VFS plugin"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deployment",
      "items": [
        "Local: install.sh, Homebrew cask or go install",
        "Container: workspace image (setup image at build) exposes OpenCode on 4096; dev target via compose",
        "Cluster: Helm chart from GHCR, or deploy/workspace/helm.sh",
        "Release: GoReleaser, cosign-signed checksums, image and chart"
      ]
    }
  ]
