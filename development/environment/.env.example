# Copy to .env (never committed; .gitignore already covers it).
# Inference/provider credentials for dev sessions inside the image.
# Every run starts from a clean container; nothing persists across
# runs except what you explicitly bind at DEV_REPO.

# OpenCode version, pinned to 2.x (must be 2.x.y; "latest" is rejected).
OPENCODE_VERSION=2.0.20

# Workspace input: host dir mounted at /work. Default ./.dev (scratch).
DEV_REPO=./.dev

# Linux only: uid/gid the container runs as, so files written into
# DEV_REPO come out host-owned instead of owned by a container uid.
# Defaults to 1000; override with `id -u`/`id -g` if that's not you.
# Not needed on macOS Docker Desktop (uid mapping is transparent).
DEV_UID=1000
DEV_GID=1000

# Provider keys (only set what you test with):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
